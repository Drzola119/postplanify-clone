# Firebase Web App Config (client-side, public)
# Get from: Firebase Console → Project Settings → General → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Firebase Admin SDK (server-side, SECRET — do not commit)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Or set FIREBASE_PRIVATE_KEY inline with \n escaped as \\n
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Bunny.net Storage (image/video uploads)
# Get from: bunny.net → Storage → your zone → FTP & API Access
# Storage API: PUT to https://{HOSTNAME}/{ZONE}/{path} with AccessKey header
# CDN delivers from: https://{CDN_HOSTNAME}/{path}
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=your-storage-zone-password
BUNNY_CDN_HOSTNAME=https://your-pull-zone.b-cdn.net

# Optional legacy n8n webhook URL. Core publishing now calls UploadPost
# directly and verifies platform results; an n8n 2xx acknowledgement is not
# considered proof of delivery. Keep this only for unrelated automations.
N8N_WEBHOOK_URL=https://your-domain.example/webhook/autopost

# Default upload-post.com username (used as fallback when no brand/account is selected)
UPLOAD_POST_DEFAULT_USERNAME=your-upload-post-username

# upload-post.com API key (server-side, SECRET — do not commit)
# JWT token from https://app.upload-post.com → API Keys
# Used by /api/social-accounts to fetch connected accounts.
UPLOAD_POST_API_KEY=your-upload-post-jwt-token-here

# Groq API key (server-side, SECRET — do not commit)
# Used by /api/ai/caption for AI caption generation:
#   - qwen/qwen3.6-27b for image analysis
#   - llama-3.1-70b-versatile for video-title caption generation
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# AI Outpainting Engine (adsify poster web app — separate Express service)
# ─────────────────────────────────────────────────────────────────────────────
# The composer calls this engine to generate per-ratio image variants
# (4:5 / 1:1 / 16:9 / 2:3) before publishing. trustiify.agency trusts the
# engine for generation only — it then publishes each variant per-platform
# to upload-post.com using the workspace's own API key.
#
# ADSIFY_ENGINE_URL — Base URL of the engine. Local: http://127.0.0.1:3000
#                     VPS:   https://engine.trustiify.agency
# ADSIFY_ENGINE_API_KEY — Optional HMAC shared secret. When set, the engine
#                         rejects requests that don't include it as
#                         `X-Engine-Api-Key`. Leave blank in dev.
# Get the URL/key from the VPS ops doc; ask the user for the production
# value via hPanel env (paste into the same row as the other *_API_KEYs).
ADSIFY_ENGINE_URL=http://127.0.0.1:3000
# ADSIFY_ENGINE_API_KEY=

# Vercel Analytics Integration (Phase C)
# VERCEL_ACCESS_TOKEN=your-vercel-access-token-here
# VERCEL_PROJECT_ID=your-vercel-project-id-here

# Higgsfield Cloud API key (server-side, SECRET — do not commit)
# Value is the colon-joined pair from https://cloud.higgsfield.ai/api-keys
# Format:    {API_KEY_ID}:{API_KEY_SECRET}
# Sent as:   Authorization: Key <value>     (literal "Key" prefix, not Bearer)
# Base URL:  https://platform.higgsfield.ai
# Used by:   src/lib/video-gen/providers/higgsfield.ts (image-to-video only)
HIGGSFIELD_API_KEY=your-higgsfield-key-id:your-higgsfield-key-secret

# ─────────────────────────────────────────────────────────────────────────────
# AI Caption Queue & xAI Grok Configuration
# ─────────────────────────────────────────────────────────────────────────────
# --- xAI Grok (primary) ---
# XAI_API_KEY is required if using xAI, else falls back to GROQ_API_KEY
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CAPTION_MODEL=grok-2-latest
XAI_VISION_MODEL=grok-2-vision-latest

# --- Groq Fallback ---
# GROQ_API_KEY is configured above
GROQ_FALLBACK_TEXT_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_VISION_MODEL=llama-3.2-11b-vision-preview

# --- Caption Queue Limits & Deadlines ---
XAI_RPS_LIMIT=30
XAI_SAFE_RPS=20
XAI_TPM_LIMIT=70000
XAI_SAFE_TPM=50000
XAI_SAFETY_FACTOR=0.7
XAI_MAX_CONCURRENCY=10
XAI_PER_USER_CONCURRENCY=2
CAPTION_TARGET_BUFFER_MINUTES=30
CAPTION_EMERGENCY_BUFFER_MINUTES=10
CAPTION_LOOKAHEAD_HOURS=24
CAPTION_WORKER_INTERVAL_MS=15000
CAPTION_PROCESSING_TIMEOUT_MS=300000
CAPTION_REQUEST_TIMEOUT_MS=30000
CAPTION_MAX_ATTEMPTS=3
CAPTION_MAX_OUTPUT_TOKENS=600
CAPTION_ESTIMATED_TOKENS=1200
CAPTION_BASE_BACKOFF_MS=2000
CAPTION_MAX_BACKOFF_MS=60000
ENABLE_DISTRIBUTED_LIMITER=false

# ─────────────────────────────────────────────────────────────────────────────
# App URL & Sentry (optional)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://postplanify.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
DIAGNOSTICS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe Billing (optional — required for paid plans)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_SCALE=

# ─────────────────────────────────────────────────────────────────────────────
# Image Generation – at least ONE must be set for infographics
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
IDEOGRAM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Additional services
# ─────────────────────────────────────────────────────────────────────────────
FAL_API_KEY=
ELEVENLABS_API_KEY=
ANALYTICS_INGEST_SECRET=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOSTNAME=
BUNNY_STORAGE_PASSWORD=
BUNNY_CDN_HOSTNAME=
API_KEY_ENCRYPTION_KEY=
